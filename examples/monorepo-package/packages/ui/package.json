{
  "name": "@demo/ui",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "auk build",
    "dev": "auk dev"
  },
  "dependencies": {
    "@demo/theme": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "http://127.0.0.1:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/es/components/*/index.d.ts",
      "default": "./dist/es/components/*/index.js"
    },
    "./style.css": "./dist/index.css",
    "./components/*.css": "./dist/es/components/*/style/index.css",
    "./themes/*.css": "./dist/es/themes/*.css",
    "./shared/chip.module.less": {
      "import": "./dist/es/shared/chip.module.less.js",
      "default": "./dist/es/shared/chip.module.less.js"
    },
    "./shared/helpers.css": "./dist/es/shared/helpers.css",
    "./shared/tokens.less": {
      "less": "./dist/es/shared/tokens.less",
      "default": "./dist/es/shared/tokens.less"
    }
  },
  "devDependencies": {
    "auklet": "link:../../../..",
    "less": "catalog:"
  }
}
