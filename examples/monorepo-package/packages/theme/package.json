{
  "name": "@demo/theme",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "auk build-css",
    "dev": "auk build-css --watch"
  },
  "files": [
    "dist",
    "tokens.less"
  ],
  "publishConfig": {
    "registry": "http://127.0.0.1:4873"
  },
  "exports": {
    "./tokens.less": {
      "less": "./tokens.less",
      "source": "./tokens.less",
      "default": "./tokens.less"
    },
    "./style.css": "./dist/index.css",
    "./themes/*.css": {
      "import": "./dist/es/themes/*.css",
      "require": "./dist/lib/themes/*.css",
      "default": "./dist/es/themes/*.css"
    }
  },
  "devDependencies": {
    "auklet": "link:../../../.."
  }
}
